{
  "functions": [
    {
      "source": "functions",
      "codebase": "reminders"
    }
  ],
  "apphosting": [
    {
      "backendId": "alpha-command-center",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        "dist",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": "dist/client",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
